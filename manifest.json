{
  "manifest_version": 3,
  "name": "Takeout for AI Chats",
  "version": "1.0.0",
  "description": "Export your ChatGPT chats, images and settings to a folder on your computer.",
  "minimum_chrome_version": "122",
  "permissions": ["storage"],
  "host_permissions": ["https://chatgpt.com/*"],
  "action": {
    "default_title": "Takeout for AI Chats",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
